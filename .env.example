# SQL Server (SSMS) Connection
# Format: sqlserver://USER:PASSWORD@SERVER:1433/DATABASE?encrypt=true&trustServerCertificate=true
DATABASE_URL="sqlserver://sa:yourpassword@localhost:1433/shop_account?encrypt=true&trustServerCertificate=true"

# Auth Secret (generate with: openssl rand -base64 32)
AUTH_SECRET="your-secret-key-at-least-32-characters-long-here"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Facebook OAuth (optional)
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""

# VietQR API (optional)
VIETQR_API_KEY=""
VIETQR_ACCOUNT_ID=""

# Banking Webhook Secret
BANKING_WEBHOOK_SECRET=""
