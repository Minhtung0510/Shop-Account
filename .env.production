# ============================================
# CẤU HÌNH PRODUCTION - SHOPACCOUNT
# ============================================
# Copy file này thành .env khi deploy lên production
# và điền các giá trị thực tế của bạn

# ====================
# DATABASE
# ====================
# SQL Server Production
DATABASE_URL="sqlserver://USER:PASSWORD@SERVER:1433/DATABASE?encrypt=true&trustServerCertificate=true"

# ====================
# AUTH - RẤT QUAN TRỌNG
# ====================
# Generate với: openssl rand -base64 32
AUTH_SECRET="YOUR-SECURE-SECRET-KEY-AT-LEAST-32-CHARS"
NEXTAUTH_URL="https://domain.com"

# ====================
# OAUTH (Optional)
# ====================
# Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Facebook OAuth
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""

# ====================
# PAYMENT & BANKING
# ====================
VIETQR_API_KEY=""
VIETQR_ACCOUNT_ID=""
BANKING_WEBHOOK_SECRET=""
SEPAY_WEBHOOK_API_KEY=""
CASSO_WEBHOOK_SECRET=""

# ====================
# EMAIL
# ====================
ADMIN_EMAIL="admin@domain.com"
RESEND_API_KEY=""
BREVO_API_KEY=""
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
FROM_EMAIL="noreply@domain.com"

# ====================
# MONITORING (Optional)
# ====================
SENTRY_DSN=""
